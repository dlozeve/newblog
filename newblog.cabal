cabal-version:      3.8
name:               newblog
version:            0.1.0.0
author:             Dimitri Lozeve

executable site
  main-is:          site.hs
  build-depends:    base
                  , containers
                  , directory
                  , filepath
                  , pandoc
                  -- 0.5.4.2 claims `pandoc < 3.14` but actually needs the 3.13 API;
                  -- pandoc 3.12.1 pairs with pandoc-lua-engine 0.5.4.1.
                  , pandoc-lua-engine < 0.5.4.2
                  , pandoc-types
                  , text
                  , hakyll >= 4
  ghc-options:      -threaded
  default-language: Haskell2010
